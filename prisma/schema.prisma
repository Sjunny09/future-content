// Future Content — Quickscan database schema
// Zie docs/quickscan/ voor volledige context

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled (PgBouncer, poort 6543, ?pgbouncer=true)
  directUrl = env("DIRECT_DATABASE_URL")   // direct (poort 5432) — voor migrate/introspect
  schemas   = ["scan"]
}

// ─────────────────────────────────────────
// SCAN / LEAD FUNNEL
// ─────────────────────────────────────────

enum ScanStatus {
  queued       // Aangemaakt, nog niet gestart
  scraping     // Site wordt gelezen
  analysing    // Claude analyseert
  ready        // Analyse klaar, vragen-flow kan starten
  answering    // Klant beantwoordt vragen
  completed    // Volledig afgerond
  failed       // Fout — fallback naar handmatige flow

  @@schema("scan")
}

// ScanJob = één sessie van begin (URL ingevoerd) tot eind (6e vraag beantwoord).
// Bevat alles: gescrapede data, Claude-analyse, observaties voor slides, gekozen vragen.
model ScanJob {
  id          String     @id @default(cuid())
  status      ScanStatus @default(queued)
  url         String     // De ingevulde website-URL
  ipHash      String     // Gehashed IP voor rate-limiting (geen rauwe IP-opslag)

  // Testscan: gezet als de scan gestart is met de admin-cookie (fc_os), dus door
  // John zelf. Zorgt dat de lead niet gemaild wordt en in het test-tabblad belandt.
  isTest      Boolean    @default(false)

  // Scrape-resultaat
  siteDataJson   Json?   // { title, description, paginas: [...] }
  scrapeBron     String? // "jina" | "cheerio"
  scrapeFaaldeOp String? // Foutmelding als scrape mislukte

  // Claude-output
  observatiesJson Json?  // ["Ik lees je homepage…", "Ik kijk naar je toon…", ...]
  analyseJson     Json?  // { branche, niche, tone, kansen: [...] }
  vragenJson      Json?  // Array van 6 vraag-ids uit bibliotheek, Haiku-gekozen

  // Vrije opmerking die de klant op de eindpagina achterlaat (optioneel).
  // Komt mee in /os en de John-notificatie zodat John context heeft.
  opmerking        String?

  // Uitgebreide (diepte) scan — optionele tweede ronde, dieper dan de quickscan
  diepteStatus     String?  // null = niet gestart, "bezig", "voltooid"
  diepteVragenJson Json?    // Logboek van de diepe vragen (zoals vragenJson)
  diagnoseJson     Json?    // { advies: "bouw"|"training"|"zelf", onderbouwing, ... }

  // Lead-koppeling
  leadId       String?
  lead         Lead?   @relation(fields: [leadId], references: [id])

  // Timings (voor performance-observability)
  startedAt    DateTime  @default(now())
  scrapedAt    DateTime?
  analysedAt   DateTime?
  readyAt      DateTime?
  completedAt  DateTime?

  antwoorden   Answer[]

  @@index([status])
  @@index([startedAt])
  @@schema("scan")
}

// Lead = de contactgegevens die pas bij vraag 6 worden opgehaald.
// Apart van ScanJob zodat we later makkelijk "alle leads" kunnen filteren
// zonder door scan-metadata te moeten spitten.
model Lead {
  id           String    @id @default(cuid())
  email        String    @unique
  naam         String?
  telefoon     String?
  bedrijfsnaam String?

  // Testlead: markeert deze lead als test (handmatig in /os of automatisch via
  // een testscan). Test-leads staan in het test-tabblad, niet in het actuele
  // overzicht, en worden niet gemaild.
  isTest       Boolean   @default(false)

  // Bel-workflow (John belt elke lead na). Zichtbaar + bewerkbaar in /os.
  gebeld       Boolean   @default(false)
  gebeldOp     DateTime? // wanneer voor het laatst als gebeld gemarkeerd
  belnotitie   String?   // vrije feedback na het bellen, blijft bij de lead

  // Mail-controle per lead: staat dit aan, dan krijgt deze lead geen
  // automatische mails meer (resultaten + herinnering). Los van de globale
  // schakelaar en van isTest.
  mailUit      Boolean   @default(false)

  // Anonimisering na 18 maanden (zie docs/quickscan/03_ceo_synthese.md §4.1)
  geanonimiseerd Boolean @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  scans        ScanJob[]
  loomVideos   LoomVideo[]
  payments     Payment[]
  mailLogs     MailLog[]

  @@index([email])
  @@index([createdAt])
  @@index([isTest])
  @@schema("scan")
}

// Antwoorden op de 6 vragen — één row per vraag
model Answer {
  id         String   @id @default(cuid())
  vraagId    String   // Bijv. "B1", "F3" uit bibliotheek
  vraagTitel String   // Snapshot (vragen-bibliotheek kan evolueren)
  waarde     Json     // string | string[] afhankelijk van vraag-type
  createdAt  DateTime @default(now())

  scanJobId  String
  scanJob    ScanJob  @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@index([scanJobId])
  @@schema("scan")
}

// Follow-up tracking voor de 24u Loom-belofte
model LoomVideo {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id])

  verstuurdOp   DateTime? // Nog niet verstuurd = null
  loomUrl       String?
  herinneringVerstuurd Boolean @default(false) // 20u-trigger mail "morgen stuur ik"
  deadline      DateTime  // 24u na scan-completion; 48u als herinnering uit

  createdAt     DateTime  @default(now())

  @@index([leadId])
  @@index([deadline])
  @@index([verstuurdOp])
  @@schema("scan")
}

// MailLog = één rij per mail die de funnel verstuurt of bewust overslaat.
// Zodat John in /os per lead precies ziet welke mails eruit zijn gegaan.
model MailLog {
  id         String   @id @default(cuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  scanJobId  String?
  ontvanger  String   // e-mailadres van de ontvanger
  richting   String   // "naar_lead" | "naar_john"
  soort      String   // "resultaten" | "john_notificatie" | "herinnering"
  onderwerp  String
  status     String   // "verstuurd" | "mislukt" | "overgeslagen"
  detail     String?  // reden bij overgeslagen of foutmelding bij mislukt
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([scanJobId])
  @@index([createdAt])
  @@schema("scan")
}

// Setting = kleine key-value voor OS-instellingen die John in /os kan omzetten
// zonder redeploy. Nu: of de funnel automatische mails naar leads stuurt.
model Setting {
  key       String   @id
  waarde    String
  updatedAt DateTime @updatedAt

  @@schema("scan")
}

// ─────────────────────────────────────────
// BETALING (Sprint 4)
// ─────────────────────────────────────────

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@schema("scan")
}

enum PaymentProvider {
  mollie
  stripe

  @@schema("scan")
}

model Payment {
  id           String          @id @default(cuid())
  provider     PaymentProvider
  providerId   String          // Mollie/Stripe payment ID
  bedragCent   Int             // €495 = 49500
  status       PaymentStatus   @default(pending)
  omschrijving String          // "Pilotweek Future Content"

  leadId       String
  lead         Lead            @relation(fields: [leadId], references: [id])

  createdAt    DateTime        @default(now())
  paidAt       DateTime?

  @@unique([provider, providerId])
  @@index([leadId])
  @@index([status])
  @@schema("scan")
}
